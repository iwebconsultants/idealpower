rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is signed in with a specific email
    function isAllowedAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'info@idealpower.com.au' || 
        request.auth.token.email == 'azam@anigravity.com'
      );
    }
    
    // Website Settings and CMS content 
    match /site_settings/{document} {
      allow read: if true; 
      allow write, update, delete: if isAllowedAdmin();
    }

    // Allow anyone to submit a contact form
    match /contact_submissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if false; 
    }
  }
}
